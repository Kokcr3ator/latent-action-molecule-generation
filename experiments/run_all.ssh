#!/usr/bin/env bash
set -e

###############################################################################
# Full pipeline: 22 runs total
#   Stage 1: Pretrain base (1 run)
#   Stage 2: Pretrain controllable (3 runs — one per num_latents)
#   Stage 3: Policy distillation (3 runs — one per controllable)
#   Stage 4: Finetune base / PPO (6 runs — one per seed, logp)
#   Stage 5: Finetune controllable / PPO (9 runs — 3 num_latents × 3 seeds, logp)
###############################################################################

# --- Variables ---------------------------------------------------------------
PRETRAIN_SEED=42
FINETUNE_SEEDS=(42 43 44)
FINETUNE_BASE_SEEDS=(42 43 44 45 46 47)
NUM_LATENTS_LIST=(8 32 128)
VOCAB_SIZE=500
export DATASET="zinc"

# --- Stage 1: Pretrain base -------------------------------------------------
echo "===== Stage 1/5: Pretrain base (seed=${PRETRAIN_SEED}) ====="
python3 -m scripts.train \
  --config configs/pretrain_base.yaml \
  --override seed=${PRETRAIN_SEED}

BASE_CKPT_DIR="ckpts/pretrain_base_vocab${VOCAB_SIZE}_seed${PRETRAIN_SEED}"

# --- Stage 2: Pretrain controllable ------------------------------------------
echo "===== Stage 2/5: Pretrain controllable ====="
for N in "${NUM_LATENTS_LIST[@]}"; do
  echo "  -- num_latents=${N}, seed=${PRETRAIN_SEED}"
  python3 -m scripts.train \
    --config configs/pretrain_controllable.yaml \
    --override seed=${PRETRAIN_SEED} \
               model.num_latents=${N}
done

# --- Stage 3: Policy distillation -------------------------------------------
echo "===== Stage 3/5: Policy distillation ====="
for N in "${NUM_LATENTS_LIST[@]}"; do
  echo "  -- num_latents=${N}, seed=${PRETRAIN_SEED}"
  python3 -m scripts.train \
    --config configs/policy_distillation.yaml \
    --override seed=${PRETRAIN_SEED} \
               loader.controllable_gpt_path="ckpts/pretrain_controllable_vocab${VOCAB_SIZE}_nlatent${N}_seed${PRETRAIN_SEED}/best.pt" \
               model.lm_head_out_size=${N}
done

# --- Stage 4: Finetune base (PPO, logp) -------------------------------------
echo "===== Stage 4/5: Finetune base (logp) ====="
for S in "${FINETUNE_BASE_SEEDS[@]}"; do
  echo "  -- seed=${S}"
  python3 -m scripts.train_ppo \
    --config configs/finetune_base.yaml \
    --override seed=${S} \
               reward.task=logp \
               ckpt.init_from=resume \
               ckpt.path="${BASE_CKPT_DIR}" \
               ckpt.ckpt_name="best.pt"
done

# --- Stage 5: Finetune controllable (PPO, logp) -----------------------------
echo "===== Stage 5/5: Finetune controllable (logp) ====="
for N in "${NUM_LATENTS_LIST[@]}"; do
  for S in "${FINETUNE_SEEDS[@]}"; do
    echo "  -- num_latents=${N}, seed=${S}"
    python3 -m scripts.train_ppo \
      --config configs/finetune_controllable.yaml \
      --override seed=${S} \
                 reward.task=logp \
                 ckpt.init_from=resume \
                 ckpt.path="ckpts/policydistillation_nlatents${N}_vocab${VOCAB_SIZE}_seed${PRETRAIN_SEED}" \
                 ckpt.ckpt_name="best.pt" \
                 loader.ckpt_controllable_path="ckpts/pretrain_controllable_vocab${VOCAB_SIZE}_nlatent${N}_seed${PRETRAIN_SEED}" \
                 loader.ckpt_name="best.pt" \
                 experiment.wandb_run_name="ppo_\${reward.task}_controllable_nlatents${N}_envs\${ppo.num_envs}_steps\${ppo.num_steps}_seed\${seed}"
  done
done

# --- Stage 6: Finetune base (PPO, sa) -------------------------------------
echo "===== Stage 6/7: Finetune base (sa) ====="
for S in "${FINETUNE_BASE_SEEDS[@]}"; do
  echo "  -- seed=${S}"
  python3 -m scripts.train_ppo \
    --config configs/finetune_base.yaml \
    --override seed=${S} \
               reward.task=sa \
               ckpt.init_from=resume \
               ckpt.path="${BASE_CKPT_DIR}" \
               ckpt.ckpt_name="best.pt"
done

# --- Stage 7: Finetune controllable (PPO, sa) -----------------------------
echo "===== Stage 7/7: Finetune controllable (sa) ====="
for N in "${NUM_LATENTS_LIST[@]}"; do
  for S in "${FINETUNE_SEEDS[@]}"; do
    echo "  -- num_latents=${N}, seed=${S}"
    python3 -m scripts.train_ppo \
      --config configs/finetune_controllable.yaml \
      --override seed=${S} \
                 reward.task=sa \
                 ckpt.init_from=resume \
                 ckpt.path="ckpts/policydistillation_nlatents${N}_vocab${VOCAB_SIZE}_seed${PRETRAIN_SEED}" \
                 ckpt.ckpt_name="best.pt" \
                 loader.ckpt_controllable_path="ckpts/pretrain_controllable_vocab${VOCAB_SIZE}_nlatent${N}_seed${PRETRAIN_SEED}" \
                 loader.ckpt_name="best.pt" \
                 experiment.wandb_run_name="ppo_\${reward.task}_controllable_nlatents${N}_envs\${ppo.num_envs}_steps\${ppo.num_steps}_seed\${seed}"
  done
done

# --- Stage 8: Finetune base (PPO, qed) -------------------------------------
echo "===== Stage 8/9: Finetune base (qed) ====="
for S in "${FINETUNE_BASE_SEEDS[@]}"; do
  echo "  -- seed=${S}"
  python3 -m scripts.train_ppo \
    --config configs/finetune_base.yaml \
    --override seed=${S} \
               reward.task=qed \
               ckpt.init_from=resume \
               ckpt.path="${BASE_CKPT_DIR}" \
               ckpt.ckpt_name="best.pt"
done

# --- Stage 9: Finetune controllable (PPO, qed) -----------------------------
echo "===== Stage 9/9: Finetune controllable (qed) ====="
for N in "${NUM_LATENTS_LIST[@]}"; do
  for S in "${FINETUNE_SEEDS[@]}"; do
    echo "  -- num_latents=${N}, seed=${S}"
    python3 -m scripts.train_ppo \
      --config configs/finetune_controllable.yaml \
      --override seed=${S} \
                 reward.task=qed \
                 ckpt.init_from=resume \
                 ckpt.path="ckpts/policydistillation_nlatents${N}_vocab${VOCAB_SIZE}_seed${PRETRAIN_SEED}" \
                 ckpt.ckpt_name="best.pt" \
                 loader.ckpt_controllable_path="ckpts/pretrain_controllable_vocab${VOCAB_SIZE}_nlatent${N}_seed${PRETRAIN_SEED}" \
                 loader.ckpt_name="best.pt" \
                 experiment.wandb_run_name="ppo_\${reward.task}_controllable_nlatents${N}_envs\${ppo.num_envs}_steps\${ppo.num_steps}_seed\${seed}"
  done
done

# --- Stage 10: Finetune base (PPO, mw) -------------------------------------
echo "===== Stage 10/11: Finetune base (mw) ====="
for S in "${FINETUNE_BASE_SEEDS[@]}"; do
  echo "  -- seed=${S}"
  python3 -m scripts.train_ppo \
    --config configs/finetune_base.yaml \
    --override seed=${S} \
               reward.task=mw \
               ckpt.init_from=resume \
               ckpt.path="${BASE_CKPT_DIR}" \
               ckpt.ckpt_name="best.pt"
done

# --- Stage 11: Finetune controllable (PPO, mw) -----------------------------
echo "===== Stage 11/11: Finetune controllable (mw) ====="
for N in "${NUM_LATENTS_LIST[@]}"; do
  for S in "${FINETUNE_SEEDS[@]}"; do
    echo "  -- num_latents=${N}, seed=${S}"
    python3 -m scripts.train_ppo \
      --config configs/finetune_controllable.yaml \
      --override seed=${S} \
                 reward.task=mw \
                 ckpt.init_from=resume \
                 ckpt.path="ckpts/policydistillation_nlatents${N}_vocab${VOCAB_SIZE}_seed${PRETRAIN_SEED}" \
                 ckpt.ckpt_name="best.pt" \
                 loader.ckpt_controllable_path="ckpts/pretrain_controllable_vocab${VOCAB_SIZE}_nlatent${N}_seed${PRETRAIN_SEED}" \
                 loader.ckpt_name="best.pt" \
                 experiment.wandb_run_name="ppo_\${reward.task}_controllable_nlatents${N}_envs\${ppo.num_envs}_steps\${ppo.num_steps}_seed\${seed}"
  done
done

# --- Stage 12: Finetune base (PPO, tpsa) -------------------------------------
echo "===== Stage 12/13: Finetune base (tpsa) ====="
for S in "${FINETUNE_BASE_SEEDS[@]}"; do
  echo "  -- seed=${S}"
  python3 -m scripts.train_ppo \
    --config configs/finetune_base.yaml \
    --override seed=${S} \
               reward.task=tpsa \
               ckpt.init_from=resume \
               ckpt.path="${BASE_CKPT_DIR}" \
               ckpt.ckpt_name="best.pt"
done

# --- Stage 13: Finetune controllable (PPO, tpsa) -----------------------------
echo "===== Stage 13/13: Finetune controllable (tpsa) ====="
for N in "${NUM_LATENTS_LIST[@]}"; do
  for S in "${FINETUNE_SEEDS[@]}"; do
    echo "  -- num_latents=${N}, seed=${S}"
    python3 -m scripts.train_ppo \
      --config configs/finetune_controllable.yaml \
      --override seed=${S} \
                 reward.task=tpsa \
                 ckpt.init_from=resume \
                 ckpt.path="ckpts/policydistillation_nlatents${N}_vocab${VOCAB_SIZE}_seed${PRETRAIN_SEED}" \
                 ckpt.ckpt_name="best.pt" \
                 loader.ckpt_controllable_path="ckpts/pretrain_controllable_vocab${VOCAB_SIZE}_nlatent${N}_seed${PRETRAIN_SEED}" \
                 loader.ckpt_name="best.pt" \
                 experiment.wandb_run_name="ppo_\${reward.task}_controllable_nlatents${N}_envs\${ppo.num_envs}_steps\${ppo.num_steps}_seed\${seed}"
  done
done
echo "===== All runs complete ====="